generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaidItemStatus {
  ACTIVE
  ERROR
  UNSUPPORTED
}

enum SyncTrigger {
  INITIAL_CONNECT
  MANUAL
  WEBHOOK
  SCHEDULED
}

enum SyncStatus {
  STARTED
  SUCCESS
  ERROR
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]
  plaidItems       PlaidItem[]
  plaidAccounts    PlaidAccount[]
  plaidHoldings    PlaidHolding[]
  plaidTransactions PlaidTransaction[]
  netWorthSnapshots NetWorthSnapshot[]
  syncRuns         SyncRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PlaidItem {
  id                  String          @id @default(cuid())
  userId              String
  plaidItemId         String          @unique
  encryptedAccessToken String
  institutionId       String?
  institutionName     String?
  status              PlaidItemStatus @default(ACTIVE)
  transactionsCursor  String?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts            PlaidAccount[]
  syncRuns            SyncRun[]

  @@index([userId])
}

model PlaidAccount {
  id               String    @id @default(cuid())
  userId           String
  itemId           String
  plaidAccountId   String
  name             String
  officialName     String?
  institutionName  String?
  mask             String?
  type             String
  subtype          String?
  assetClass       String
  isSupported      Boolean   @default(true)
  unsupportedReason String?
  currentBalance   Decimal?  @db.Decimal(16, 2)
  availableBalance Decimal?  @db.Decimal(16, 2)
  isoCurrencyCode  String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item             PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  holdings         PlaidHolding[]
  transactions     PlaidTransaction[]

  @@unique([userId, plaidAccountId])
  @@index([userId, itemId])
}

model PlaidHolding {
  id             String       @id @default(cuid())
  userId         String
  accountId      String
  securityId     String?
  symbol         String?
  name           String
  quantity       Decimal?     @db.Decimal(18, 6)
  price          Decimal?     @db.Decimal(16, 4)
  marketValue    Decimal      @db.Decimal(16, 2)
  costBasis      Decimal?     @db.Decimal(16, 2)
  dayChangePct   Decimal?     @db.Decimal(8, 4)
  assetClass     String
  isoCurrencyCode String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        PlaidAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId])
}

model PlaidTransaction {
  id                 String       @id @default(cuid())
  userId             String
  accountId          String
  plaidTransactionId String       @unique
  amount             Decimal      @db.Decimal(16, 2)
  isoCurrencyCode    String?
  date               DateTime
  authorizedDate     DateTime?
  name               String
  merchantName       String?
  category           Json?
  pending            Boolean      @default(false)
  paymentChannel     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            PlaidAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, accountId, date])
}

model NetWorthSnapshot {
  id               String      @id @default(cuid())
  userId           String
  timestamp        DateTime    @default(now())
  totalAssets      Decimal     @db.Decimal(16, 2)
  totalLiabilities Decimal     @db.Decimal(16, 2)
  netWorth         Decimal     @db.Decimal(16, 2)
  byAssetClass     Json
  byAccount        Json
  trigger          SyncTrigger
  createdAt        DateTime    @default(now())
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

model SyncRun {
  id         String      @id @default(cuid())
  userId     String
  itemId     String?
  trigger    SyncTrigger
  status     SyncStatus
  message    String?
  metadata   Json?
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       PlaidItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
