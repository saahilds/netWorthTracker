{
  "name": "net-worth-tracker",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "scripts": {
    "setup:cloud": "bash ./scripts/bootstrap-cloud-agent.sh",
    "verify:workspace": "npm install && npm run typecheck && npm run build",
    "dev:web": "npm run dev --workspace @networth/web",
    "dev:mobile": "npm run start --workspace @networth/mobile",
    "build": "npm run build --workspace @networth/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.18.0 <23",
    "npm": ">=10.8.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@types/react": "19.1.10"
  }
}
